# Copy to .env and fill in your keys
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional
APP_PORT=8000
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-IN
DEEPGRAM_TTS_VOICE=aura-asteria-en
# City for weather; leave blank to detect from IP
ANVI_LOCATION=
# Set to 0 to stop main.py opening the browser
ANVI_OPEN_BROWSER=1

# Optional: reliable web search (otherwise keyless scraping is used)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Phone access: HTTPS server on the local network (pair with the phone button)
ANVI_PHONE=1
ANVI_PHONE_PORT=8443
# Optional: Tailscale address for using Karen from any network, e.g. https://my-laptop.tail1234.ts.net
ANVI_PUBLIC_URL=
