# Copy to .env and fill in your keys
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional
APP_PORT=8000
GROQ_MODEL=openai/gpt-oss-120b
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_VOICE=aura-asteria-en
# City for weather; leave blank to detect from IP
ANVI_LOCATION=
# Set to 0 to stop main.py opening the browser
ANVI_OPEN_BROWSER=1
